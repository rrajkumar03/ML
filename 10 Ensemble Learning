import time
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

# Load the Breast Cancer dataset
data = load_breast_cancer()
X = pd.DataFrame(data.data, columns=data.feature_names)
y = pd.Series(data.target)

# Split dataset into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

# Define machine learning models
models = {
    "Logistic Regression (Baseline)": make_pipeline(
        StandardScaler(),
        LogisticRegression(max_iter=5000)
    ),
    "Random Forest": RandomForestClassifier(
        n_estimators=100, random_state=42
    ),
    "Gradient Boosting": GradientBoostingClassifier(
        random_state=42
    )
}

# Train models and evaluate performance
results = []

for name, model in models.items():
    start = time.perf_counter()

    model.fit(X_train, y_train)

    train_time = time.perf_counter() - start
    y_pred = model.predict(X_test)

    results.append({
        "Model": name,
        "Accuracy": accuracy_score(y_test, y_pred),
        "Precision (Malignant)": precision_score(
            y_test, y_pred, pos_label=0, zero_division=0
        ),
        "Recall (Malignant)": recall_score(
            y_test, y_pred, pos_label=0, zero_division=0
        ),
        "F1 (Malignant)": f1_score(
            y_test, y_pred, pos_label=0, zero_division=0
        ),
        "Training Time (s)": train_time
    })

# Display comparison table
results_df = pd.DataFrame(results)
print("Model Performance Comparison:")
print(results_df.round(4).to_string(index=False))

# Plot predictive performance comparison
plot_df = results_df.set_index("Model")[
    [
        "Accuracy",
        "Precision (Malignant)",
        "Recall (Malignant)",
        "F1 (Malignant)"
    ]
]

plot_df.plot(kind="bar", ylim=(0, 1), figsize=(8, 5))
plt.title("Baseline vs Ensemble Classifiers")
plt.ylabel("Score")
plt.xticks(rotation=15, ha="right")
plt.tight_layout()
plt.show()

# Plot training time comparison
plt.figure(figsize=(8, 5))
plt.bar(results_df["Model"], results_df["Training Time (s)"])
plt.title("Training Time Comparison of Classifiers")
plt.xlabel("Machine Learning Models")
plt.ylabel("Training Time (seconds)")
plt.xticks(rotation=15, ha="right")
plt.tight_layout()
plt.show()
