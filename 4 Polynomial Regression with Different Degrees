import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_diabetes
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error,r2_score
# Load dataset
diabetes = load_diabetes()
# Select only one feature (BMI)
X = diabetes.data[:, np.newaxis, 2]
y = diabetes.target
# Split dataset
X_train,X_test,y_train,y_test = train_test_split(
    X,y,test_size=0.30,random_state=42)
degrees=[1,2,3,5,10]
print("Degree\tTrain R2\tTest R2\tMSE")
for degree in degrees:
    poly=PolynomialFeatures(degree)
    X_train_poly=poly.fit_transform(X_train)
    X_test_poly=poly.transform(X_test)
    model=LinearRegression()
    model.fit(X_train_poly,y_train)
    train_pred=model.predict(X_train_poly)
    test_pred=model.predict(X_test_poly)
    train_r2=r2_score(y_train,train_pred)
    test_r2=r2_score(y_test,test_pred)
    mse=mean_squared_error(y_test,test_pred)
    print(f"{degree}\t{train_r2:.3f}\t\t{test_r2:.3f}\t\t{mse:.2f}")
    # Plot
    X_grid=np.linspace(min(X),max(X),200).reshape(-1,1)
    X_grid_poly=poly.transform(X_grid)
    y_grid=model.predict(X_grid_poly)
    plt.figure(figsize=(6,4))
    plt.scatter(X,y,color='blue')
    plt.plot(X_grid,y_grid,color='red')
    plt.title(f'Polynomial Degree {degree}')
    plt.xlabel('BMI')
    plt.ylabel('Disease Progression')
    plt.show()
